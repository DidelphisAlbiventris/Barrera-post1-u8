     1                              <1> ; Instantanea de 14 bytes: AX,BX,CX,DX,SI,DI,FLAGS.
     2                              <1> ; PUSHF/POP memoria y MOV preservan los flags: seguro entre ADD y ADC.
     3                              <1> %macro SNAP 1
     4                              <1>     pushf
     5                              <1>     pop word [%1+12]
     6                              <1>     mov [%1], ax
     7                              <1>     mov [%1+2], bx
